{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ComfyUI Launcher",
  "version": "0.1.0",
  "identifier": "com.arkaikus.comfyui-installer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "ComfyUI",
        "width": 760,
        "height": 640,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Graphics",
    "shortDescription": "Install and run ComfyUI on Arch",
    "longDescription": "Arch/CachyOS launcher that installs ComfyUI and starts it without a terminal.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
